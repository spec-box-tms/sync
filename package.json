{
    "name": "spec-box-tms-sync",
    "version": "1.1.1",
    "private": false,
    "bin": {
        "spec-box": "./bin/spec-box"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 ts-node ./src/cli.ts",
        "start:ui": "npm --prefix ./serve-ui run start",
        "serve": "npm start -- serve --port 3000",
        "build": "sh ./utils/build.sh",
        "prepublishOnly": "npm run build",
        "generate-api": "./utils/generate-api.sh",
        "test": "npm run test:serve && npm run test:unit",
        "test:serve": "mkdir -p test-results && node --test -r ts-node/register --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml test/{cli,proposes,serve}/**/*.test.ts",
        "test:unit": "node --test -r ts-node/register test/helpers/*.test.ts",
        "test-ext": "./bin/spec-box sync",
        "version-beta": "npm version prerelease --preid beta",
        "publish-beta": "npm publish --tag beta"
    },
    "license": "MIT",
    "dependencies": {
        "@azure/core-client": "^1.7.3",
        "@azure/core-rest-pipeline": "^1.11.0",
        "@types/express": "4.17.25",
        "@types/xml2js": "0.4.14",
        "chalk": "^4.1.0",
        "express": "4.22.2",
        "fast-glob": "^3.3.0",
        "fp-ts": "^2.16.0",
        "fs-extra": "^11.1.1",
        "io-ts": "^2.2.20",
        "tslib": "^2.6.0",
        "xml2js": "0.6.2",
        "yaml": "^2.3.1",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@types/fs-extra": "^11.0.1",
        "@types/node": "^20.4.2",
        "@types/yargs": "^17.0.24",
        "autorest": "^3.6.3",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.6"
    }
}
